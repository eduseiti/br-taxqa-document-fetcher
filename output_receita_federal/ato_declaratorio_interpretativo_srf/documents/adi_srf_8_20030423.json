      "textoIntegra": "Dispõe sobre o tratamento tributário das aplicações financeiras realizadas em moeda estrangeira nas hipóteses que especifica.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
