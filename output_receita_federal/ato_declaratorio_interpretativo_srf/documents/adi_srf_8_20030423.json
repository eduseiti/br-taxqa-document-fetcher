  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 27482,
      "versaoSegmento": 1,
      "idTipoSegmento": 2,
      "idAssunto": 999,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO DA RECEITA FEDERAL, no uso da atribuição que lhe confere o inciso III do art. 209 do Regimento Interno da Secretaria da Receita Federal, aprovado pela Portaria MF nº 259, de 24 de agosto de 2001, e tendo em vista o disposto no art. 24 da Medida Provisória nº 2.158-35, de 24 de agosto de 2001, e no Processo nº 10168.001178/2003-70, declara:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 27483,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º O crédito de rendimentos relativos a aplicação financeira, inclusive depósito remunerado, realizada em moeda estrangeira por pessoa física residente no Brasil, implica a apuração de ganho de capital tributável, desde que o valor creditado seja passível de saque pelo beneficiário.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 27484,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º São isentos os ganhos de capital relativos às aplicações financeiras realizadas em moeda estrangeira pela pessoa física na condição de não-residente no Brasil:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 316506,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - correspondentes ao primeiro crédito de rendimentos ocorrido a partir da data da caracterização da condição de residente no Brasil, na hipótese de aplicação financeira realizada por tempo indeterminado, inclusive depósito remunerado;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 316507,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - apurados na liquidação ou resgate, a partir da data da caracterização da condição de residente no Brasil, de aplicação financeira realizada por tempo determinado.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 27485,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 3º Implica a apuração de ganho de capital tributável a liquidação ou resgate de aplicações financeiras:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 316508,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - mantidas pela pessoa física após o primeiro crédito de rendimentos ocorrido a partir da data da caracterização da condição de residente no Brasil, na hipótese do inciso I do art. 2º;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5614,
      "idSegmento": 316509,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - correspondentes à reaplicação total ou parcial dos valores liquidados ou resgatados, na hipótese do inciso II do art. 2º.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
