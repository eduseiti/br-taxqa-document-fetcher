      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "JORGE ANTONIO DEHER RACHID",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    }
