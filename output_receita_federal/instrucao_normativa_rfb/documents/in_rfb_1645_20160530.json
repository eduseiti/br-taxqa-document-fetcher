      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Dispõe sobre a incidência do Imposto sobre a Renda Retido na Fonte sobre rendimentos pagos, creditados, empregados, entregues ou remetidos para pessoas jurídicas domiciliadas no exterior nas hipóteses que menciona.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
