    }
  ],
  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632299,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO DA RECEITA FEDERAL DO BRASIL, no uso da atribuição que lhe confere o inciso III do art. 280 do Regimento Interno da Secretaria da Receita Federal do Brasil, aprovado pela Portaria MF nº 203, de 14 de maio de 2012, e tendo em vista o disposto no art. 60 da Lei nº 12.249, 11 de junho de 2010, e na Medida Provisória nº 713, de 1º de março de 2016, resolve:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632300,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º Esta Instrução Normativa dispõe sobre a incidência do Imposto sobre a Renda Retido na Fonte (IRRF) sobre valores pagos, creditados, empregados, entregues ou remetidos para o exterior:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632301,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - destinados à cobertura de gastos pessoais, no exterior, de pessoas físicas residentes no País, em viagens;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632302,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - para fins educacionais, científicos ou culturais; e",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632303,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "III - para a cobertura de despesas médico-hospitalares com tratamento de saúde, no exterior, do remetente ou de seus dependentes.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632304,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º Até 31 de dezembro de 2019, fica reduzida a 6% (seis por cento) a alíquota do IRRF incidente sobre os valores pagos, creditados, entregues, empregados ou remetidos para pessoa física ou jurídica residente ou domiciliada no exterior, destinados à cobertura de gastos pessoais, no exterior, de pessoas físicas residentes no País, em viagens de turismo, negócios, serviço, treinamento ou missões oficiais, até o limite global de R$ 20.000,00 (vinte mil reais) ao mês.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632305,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º A redução de alíquota somente se aplica às despesas com viagens internacionais de pessoas físicas residentes no Brasil.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632306,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2º São gastos pessoais no exterior, para efeito da redução de que trata o caput, as despesas para manutenção do viajante, tais como despesas com hotéis, transporte, hospedagem, cruzeiros marítimos, aluguel de automóveis e seguro a viajantes.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632307,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 10,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3º A redução de alíquota de que trata o caput se aplica às remessas efetuadas por pessoa jurídica, domiciliada no País, que arque com despesas pessoais de seus empregados e dirigentes residentes no País, registrados em carteira de trabalho.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632308,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 11,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 4º A redução de alíquota de que trata o caput não se aplica no caso de beneficiário residente ou domiciliado em país ou dependência com tributação favorecida ou beneficiada por regime fiscal privilegiado, conforme constam nos arts. 24 e 24-A da Lei nº 9.430, de 27 de dezembro de 1996, salvo se atendidas, cumulativamente, as seguintes condições:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632309,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 12,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - a identificação do efetivo beneficiário da entidade no exterior, destinatário dos valores pagos, creditados, entregues, empregados ou remetidos, a que se refere o caput;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632310,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 13,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - a comprovação da capacidade operacional da pessoa física ou entidade no exterior de realizar a operação; e",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632311,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 14,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "III - a comprovação documental do pagamento do preço respectivo e do recebimento dos bens e direitos ou da utilização de serviço.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632312,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 15,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 5º O limite global previsto no caput não se aplica em relação às operadoras e agências de viagem.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632313,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 16,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 6º As operadoras e agências de viagem, na hipótese de cumprimento das condições do § 4º, sujeitam-se ao limite de R$ 10.000,00 (dez mil reais) ao mês por viajante.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632314,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 17,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 7º A hipótese de que trata o § 6º aplica-se somente aos gastos pessoais do viajante definidos no § 2º.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632315,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 18,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 8º Para fins de fruição da redução, não serão admitidas quaisquer outras despesas, além das mencionadas no § 2º do art. 2º, remetidas por operadoras e agências de viagens para pessoas físicas ou jurídicas residentes no exterior, tais como o pagamento de corretagens ou comissões.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632316,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 19,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 3º As operadoras e as agências de viagem deverão elaborar e manter, em dispositivo de armazenamento por meio magnético, óptico ou eletrônico, demonstrativo das remessas sujeitas à redução de que trata o art. 2º, inclusive para reservas ou bloqueios de serviços turísticos sem viajante previamente definido.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632317,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 20,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º O viajante de que trata o caput deverá ser pessoa física residente no Brasil.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632318,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 21,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2º A operadora de viagens deverá manter o controle de que trata o caput para cada agência de viagens, nos casos em que efetuar a remessa consolidada de valores decorrentes de vendas realizadas por agências de viagens.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632319,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 22,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3º Na hipótese de viajante definido, o demonstrativo de que trata o caput deverá conter o valor de cada remessa atrelado ao correspondente número do Cadastro de Pessoas Físicas (CPF) do viajante.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632320,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 23,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 4º Na hipótese de o viajante ser menor e não possuir número de CPF, deverá ser informado, no demonstrativo a que se refere o caput, o número do CPF do responsável.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632321,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 24,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 5º O demonstrativo a que se refere o caput deverá ser comprovado com as notas fiscais da prestação de serviço de viagem vendida em nome da pessoa física viajante e o número do seu CPF.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632322,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 25,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 6º No momento da definição do viajante, o demonstrativo de que trata o caput deverá indicar a correlação entre a reserva e o bloqueio de serviços turísticos e o CPF do viajante.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632323,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 26,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 7º Na hipótese de não ocorrência da venda, deverá ser efetuado o recolhimento da diferença de IRRF incidente sobre a parcela referente aos valores remetidos e não restituídos à operadora ou agência de viagem, salvo na hipótese de caso fortuito ou de força maior.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632324,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 27,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 8º A responsabilidade pelo imposto sobre a renda que deixar de ser retido é da pessoa jurídica remetente, inclusive no caso previsto no § 2º.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632325,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 28,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 9º O demonstrativo de que trata o caput deverá ser mantido pelas operadoras e agências de viagem para fins de auditoria fiscal, não sendo exigida a sua apresentação à instituição financeira contratada para a realização da remessa.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 74319,
      "idSegmento": 1632326,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 29,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
