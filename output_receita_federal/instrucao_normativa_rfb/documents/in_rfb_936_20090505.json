  "ementas": [
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126590,
      "versaoSegmento": 1,
      "idTipoSegmento": 1,
      "idAssunto": 999,
      "ordemSegmentoAto": 1,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Dispõe sobre o tratamento tributário relativo a valores pagos a título de abono pecuniário de férias.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    }
  ],
  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126591,
      "versaoSegmento": 1,
      "idTipoSegmento": 2,
      "idAssunto": 999,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "A SECRETÁRIA DA RECEITA FEDERAL DO BRASIL, no uso da atribuição que lhe confere o inciso III do art. 261 do Regimento Interno da Secretaria da Receita Federal do Brasil, aprovado pela Portaria MF nº 125, de 4 de março de 2009, e tendo em vista o Ato Declaratório PGFN nº 6, de 16 de novembro de 2006, resolve:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126592,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º Os valores pagos a pessoa física a título de abono pecuniário de férias de que trata o art. 143 da Consolidação das Leis do Trabalho (CLT), aprovada pelo Decreto-Lei nº 5.452, de 1º de maio de 1943, não serão tributados pelo imposto de renda na fonte nem na Declaração de Ajuste Anual.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126593,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º A pessoa física que recebeu os rendimentos de que trata o art. 1º com desconto do imposto de renda na fonte e que incluiu tais rendimentos na Declaração de Ajuste Anual como tributáveis, para pleitear a restituição da retenção indevida, deverá apresentar declaração retificadora do respectivo exercício da retenção, excluindo o valor recebido a título de abono pecuniário de férias do campo \"rendimentos tributáveis\" e informando-o no campo \"outros\" da ficha \"rendimentos isentos e não tributáveis\", com especificação da natureza do rendimento.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504615,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º Para fins do disposto no caput, na declaração retificadora deverão ser mantidas todas as demais informações constantes da declaração original que não sofreram alterações.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504616,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2º A declaração retificadora deverá ser apresentada:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504617,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - pela Internet, mediante a utilização do programa de transmissão Receitanet, disponível no sítio da Secretaria da Receita Federal do Brasil (RFB) no endereço  ; ou",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504618,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - em disquete, nas unidades da RFB, durante o seu horário de expediente.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504619,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3º Para a elaboração e transmissão da declaração retificadora deverão ser utilizados o Programa Gerador da Declaração (PGD) relativo ao exercício da retenção indevida e o mesmo modelo (completo ou simplificado) utilizado para a declaração original, bem como deverá ser informado o número constante no recibo de entrega referente a esta declaração original.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504620,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 10,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 4º Se da declaração retificadora resultar saldo de imposto a restituir superior ao da declaração original, a diferença entre o saldo a restituir referente à declaração retificadora e o valor eventualmente já restituído, será objeto de restituição automática.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126594,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 11,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 3º No caso de ter havido recolhimento de imposto no exercício a que se refere o art. 2º, se da retificação da declaração resultar pagamento indevido, a restituição ou compensação do imposto pago indevidamente na declaração original deverá ser requerida mediante a utilização do programa Pedido de Restituição, Ressarcimento ou Reembolso e Declaração de Compensação (PER/DCOMP), disponível no sítio da RFB na Internet, no endereço mencionado no inciso I do § 2º do art. 2º.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126595,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 12,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 4º O prazo para pleitear a restituição é de 5 (cinco) anos contados da data da retenção indevida.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126596,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 13,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 5º O pagamento da restituição, acrescida de juros equivalentes à taxa referencial do Sistema Especial de Liquidação e de Custódia (Selic) para títulos federais, acumulada mensalmente a partir do mês de maio do exercício correspondente ao da declaração original até o mês anterior ao da restituição, e de 1% (um por cento) no mês em que o crédito for disponibilizado ao contribuinte no banco, será efetuado por meio dos lotes mensais de restituição do Imposto sobre a Renda da Pessoa Física, disponíveis na rede bancária.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126597,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 14,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 6º A fonte pagadora dos rendimentos de que trata o art. 1º poderá apresentar a Declaração do Imposto de Renda Retido na Fonte (Dirf) retificadora.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 504621,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 15,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. A retificação de que trata o caput não se enquadra no disposto no art. 7º da Lei nº 10.426, de 24 de abril de 2002.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126598,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 16,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 7º Esta Instrução Normativa entra em vigor na data da sua publicação.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15897,
      "idSegmento": 126599,
      "versaoSegmento": 1,
      "idTipoSegmento": 4,
      "idAssunto": 999,
      "ordemSegmentoAto": 17,
