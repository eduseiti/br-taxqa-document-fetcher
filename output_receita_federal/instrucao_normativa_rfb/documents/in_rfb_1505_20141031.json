      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "“Seção V Das Demais Disposições",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
