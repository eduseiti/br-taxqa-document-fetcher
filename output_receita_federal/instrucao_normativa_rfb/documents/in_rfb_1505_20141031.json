      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 387. .................................................................................”",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 57747,
      "idSegmento": 1460422,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 47,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 4º Esta Instrução Normativa entra em vigor na data de sua publicação no Diário Oficial da União.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 57747,
      "idSegmento": 1460423,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 48,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 5º Ficam revogados a Instrução Normativa RFB nº 734, de 2 de maio de 2007, os §§ 7º a 10 do art. 383 e os arts. 405 a 442 da Instrução Normativa RFB nº 971, de 13 novembro de 2009.",
      "ancorasOrigem": [],
