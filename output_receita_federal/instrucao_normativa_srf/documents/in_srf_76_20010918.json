  "ementas": [
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104814,
      "versaoSegmento": 1,
      "idTipoSegmento": 1,
      "idAssunto": 999,
      "ordemSegmentoAto": 1,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Dispõe sobre as restituições do imposto de renda das pessoas físicas pela rede arrecadadora de receitas federais.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    }
  ],
  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104815,
      "versaoSegmento": 1,
      "idTipoSegmento": 2,
      "idAssunto": 999,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO DA RECEITA FEDERAL, no uso da atribuição que lhe confere o inciso III do art. 209 do Regimento Interno da Secretaria da Receita Federal, aprovado pela Portaria MF No 259, de 24 de agosto de 2001, e tendo em vista o disposto no art. 16 da Lei No 9.250, de 26 de dezembro de 1995, resolve:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104816,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1o O valor do imposto de renda pago a maior, apurado na declaração de ajuste anual do imposto de renda das pessoas físicas, será restituído por intermédio dos bancos integrantes da rede arrecadadora de receitas federais autorizados a receber as declarações, bem assim pelos demais bancos indicados pelos contribuintes, observadas as disposições desta Instrução Normativa.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104817,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2o A Secretaria da Receita Federal (SRF) fornecerá aos bancos, em meio magnético:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453552,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - a relação nominal dos contribuintes, com a indicação do número da conta corrente ou de poupança e da respectiva agência, informados na declaração de ajuste, para crédito do valor a restituir;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453553,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - o valor em reais a ser restituído a cada contribuinte, acrescido de juros equivalentes à taxa referencial do Sistema Especial de Liquidação e de Custódia (Selic) acumulada mensalmente a partir do mês de maio do exercício previsto para entrega das declarações de ajuste, até o mês anterior àquele em que os recursos forem colocados em disponibilidade, em estabelecimento bancário, em favor do contribuinte, e de um por cento no mês da referida disponibilização.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453554,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. A incidência de juros sobre os valores a restituir cessará a partir do primeiro dia do mês subseqüente àquele em que os recursos forem disponibilizados, em estabelecimento bancário, em favor do contribuinte.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104818,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 3o Os valores das restituições serão repassados aos bancos integrantes da rede de recepção de declarações, por intermédio da Secretaria do Tesouro Nacional (STN), a cada lote de processamento, com antecedência de cinco dias úteis da data a partir da qual ficarão disponíveis para pagamento aos destinatários.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453555,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1o Para os bancos que somente integram a rede de crédito das restituições e para os demais que, embora não integrando a rede de crédito, venham a ser indicados pelo contribuinte, os recursos serão repassados pelo Banco do Brasil S/A, por meio de Documento de Compensação do Sistema de Administração Financeira do Governo Federal (DOC-Siafi), no dia anterior ao previsto para início do crédito.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453556,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 10,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2o Na hipótese do § 1o deste artigo, os recursos serão transferidos ao Banco do Brasil pela STN, com antecedência de seis dias úteis da data fixada para o pagamento da restituição.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104819,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 11,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 4o A SRF expedirá comunicação aos contribuintes para informar o valor da restituição, o banco e a agência bancária encarregada do crédito ou a agência do Banco do Brasil onde este ficará disponível aguardando autorização de crédito ou transferência.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104820,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 12,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 5o O crédito deverá ser efetuado em conta corrente ou de poupança dos destinatários das restituições devidamente identificados pelo estabelecimento bancário.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453557,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 13,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1o A prova inequívoca do crédito da restituição ao contribuinte é de inteira responsabilidade do Banco, que manterá os comprovantes dos pagamentos efetuados, ou respectivos microfilmes, por lotes, durante cinco anos, contados da data do pagamento.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453558,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 14,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2o O Banco deverá creditar o valor da restituição na conta indicada pelo contribuinte em sua declaração de ajuste anual, conforme constar do arquivo magnético a ser fornecido pela SRF.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453559,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 15,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3o Na hipótese de não haver indicação de conta corrente ou de conta de poupança na declaração de ajuste, ou de indicação com dados incorretos que impeçam sua identificação, a restituição ficará disponível no Banco do Brasil, que providenciará o crédito em conta corrente ou de poupança que vier a ser indicada pelo contribuinte.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104821,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 16,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 6o Para efeito de restituição a outra pessoa que não o próprio contribuinte, a pessoa indicada para recebê-la deverá informar a conta corrente ou de poupança (número da conta, banco e agência) de sua titularidade e apresentar:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453560,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 17,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - instrumento público de procuração;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453561,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 18,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - Alvará Judicial, no caso de contribuinte falecido, quando houver bens a inventariar, ou autorização emitida pela autoridade fiscal da jurisdição do contribuinte, quando não houver bens a inventariar ou a arrolar, observado o disposto na Instrução Normativa SRF No 56/89, de 31 de maio de 1989;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453562,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 19,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1o Quando a restituição for devida a menor de idade, o pagamento será efetuado a um dos pais, que deverá apresentar autorização do cônjuge ou certidão de óbito, se este for falecido, ou ao tutor, que apresentará o Termo de Tutela.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453563,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 20,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2o Os documentos de que trata este artigo deverão ser mantidos em boa guarda pelo estabelecimento bancário, pelo prazo referido no § 1o do art. 5o.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104822,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 21,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 7o O contribuinte que entender insuficiente o valor da restituição poderá receber a importância disponível no banco e reclamar a diferença na unidade local da SRF.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453564,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 22,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. Na hipótese de o valor da restituição ser maior que o apurado na declaração de ajuste anual e não constarem da comunicação expedida pela SRF as causas da alteração do valor, o contribuinte deverá procurar a unidade da SRF.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104823,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 23,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 8o Decorrido o período um ano, contado do dia em que os valores das restituições ficaram disponíveis para resgate, os bancos recolherão ao Tesouro Nacional os valores correspondentes às restituições não pagas.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453565,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 24,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. O recolhimento deverá ser efetuado até o décimo dia útil subseqüente ao do vencimento do prazo mencionado neste artigo, mediante Documento de Arrecadação de Receitas Federais (Darf), com o código de receita 4634.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104824,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 25,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 9o Os bancos deverão encaminhar à SRF, até o décimo dia útil subseqüente ao do vencimento do prazo mencionado no parágrafo único do art. 8o, a prestação de contas relativa às restituições.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104825,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 26,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 10. O banco, cuja prestação de contas for rejeitada pelo processamento, terá o prazo de dez dias úteis, contado da data da devolução da fita magnética, disquete ou transmissão eletrônica rejeitada, para reapresentar sua prestação de contas.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104826,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 27,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 11. A prestação de contas das restituições pagas por meio de DOC-Siafi será feita pelo Banco do Brasil, observados os prazos constantes dos arts. 9o e 10 desta Instrução Normativa.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104827,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 28,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 12. O descumprimento das normas relativas à restituição sujeita os bancos às seguintes penalidades:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453567,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 29,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - no caso de pagamento ou crédito da restituição à pessoa indevida, multa de 10% sobre o valor restituído, não inferior a R$ 50,00 (cinqüenta reais), independentemente do ressarcimento à União do valor pago indevidamente, acrescido dos juros previstos no inciso II do art. 2o, calculados até a data do ressarcimento;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453568,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 30,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - no caso de inobservância dos prazos previstos nos arts. 8o ao 10 desta Instrução Normativa ou de rejeição da reapresentação da prestação de contas:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453569,
      "versaoSegmento": 1,
      "idTipoSegmento": 14,
      "idAssunto": 999,
      "ordemSegmentoAto": 31,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "a) multa de R$ 20,00 (vinte reais) por dia de atraso na devolução dos arquivos cujas restituições tenham sido integralmente pagas;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453570,
      "versaoSegmento": 1,
      "idTipoSegmento": 14,
      "idAssunto": 999,
      "ordemSegmentoAto": 32,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "b) multa de 0,2% (dois décimos por cento) ao dia sobre o valor total das restituições não pagas, relacionadas nos arquivos devolvidos com atraso, limitada a 20% (vinte por cento);",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453571,
      "versaoSegmento": 1,
      "idTipoSegmento": 14,
      "idAssunto": 999,
      "ordemSegmentoAto": 33,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "c) multa de 0,2% (dois décimos por cento) ao dia e juros de mora de um por cento ao mês (cálculo diário) sobre o valor das restituições não pagas, que não foram devolvidas ao Tesouro Nacional, e das que foram devolvidas com atraso ou recolhidas a menor, limitada a 20% (vinte por cento).",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 453572,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 34,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. Transcorridos trinta dias da aplicação de multa sem que a prestação de contas tenha sido apresentada corretamente, fica o banco infrator desligado da rede arrecadadora de receitas federais, por ato do Coordenador-Geral de Administração Tributária.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104828,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 35,
      "omitir": false,
      "tachado": true,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 13. A Coordenação-Geral de Administração Tributária poderá editar atos necessários à execução desta Instrução Normativa.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 14286,
      "idSegmento": 104829,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
