  "ementas": [
    {
      "mapper": null,
      "idAto": 15166,
      "idSegmento": 117553,
      "versaoSegmento": 1,
      "idTipoSegmento": 1,
      "idAssunto": 999,
      "ordemSegmentoAto": 1,
