  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 2202324,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO DA RECEITA FEDERAL, no uso das suas atribuições e tendo em vista que, em decorrência de decisões definitivas das egrégias Primeira e Segunda Turmas do Superior Tribunal de Justiça, o Procurador-Geral da Fazenda Nacional, por meio do despacho de 17 de setembro de 1998, publicado no Diário Oficial da União de 22 de setembro de 1998, baseado no Parecer PGFN/CRJ/nº 1278/98, devidamente aprovado pelo Ministro de Estado da Fazenda, dispensou \"a interposição de recursos e a desistência dos já interpostos nas ações que cuidam, no mérito, exclusivamente, da não incidência do Imposto de Renda na fonte sobre verbas indenizatórias referentes\" a programas de demissão voluntária, resolve:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 115131,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º Fica dispensada a constituição de créditos da Fazenda Nacional relativamente à incidência do Imposto de Renda na fonte sobre as verbas indenizatórias pagas em decorrência de incentivo à demissão voluntária.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 115132,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º Ficam os Delegados e Inspetores da Receita Federal autorizados a rever de ofício os lançamentos referentes à matéria de que trata o artigo anterior, para fins de alterar total ou parcialmente os respectivos créditos da Fazenda Nacional.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 476476,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º Na hipótese de créditos constituídos, pendentes de julgamento, os Delegados de Julgamento da Receita Federal subtrairão a matéria de que trata o artigo anterior.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 476477,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2º As autoridades referidas no caput deste artigo deverão encaminhar para a Coordenação-Geral do Sistema de Arrecadação - COSAR, por intermédio das Superintendências Regionais da Receita Federal de sua jurisdição, no prazo de 60 dias, contado da publicação desta Instrução Normativa, relação pormenorizada dos lançamentos revistos, contendo as seguintes informações:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 476478,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - nome do contribuinte e respectivo número de inscrição no Cadastro Nacional das Pessoas Jurídicas - CNPJ ou Cadastro da Pessoa Física - CPF, conforme o caso;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 476479,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - valor atualizado do crédito revisto e data do lançamento;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15014,
      "idSegmento": 476480,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "III - fundamento da revisão mediante referência à norma contida no artigo anterior.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
