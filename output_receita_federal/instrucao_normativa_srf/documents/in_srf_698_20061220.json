      "original": true,
      "compilado": false,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3º Nas hipóteses do § 1º e do inciso I do § 2º, as fontes pagadoras deverão manter sistema de controle que permita o fornecimento, por escrito, do Informe de Rendimentos Financeiros, quando solicitado.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15640,
      "idSegmento": 498112,
      "versaoSegmento": 2,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 18,
      "omitir": false,
      "tachado": false,
      "original": false,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 3º Nas hipóteses do § 1º e dos incisos I e IV do § 2º, as fontes pagadoras deverão manter sistema de controle que permita o fornecimento, por via impressa, do Informe de Rendimentos Financeiros, quando solicitado.",
      "ancorasOrigem": [],
      "ancorasDestino": [
        {
          "idAto": 37201,
          "idSegmento": 951903,
          "idAnotacao": 184519,
