          "permiteExcluir": true,
          "permiteAlterarData": true,
          "ehAgendamento": false,
          "textoAgendamento": null,
          "exibirDataInicioVigencia": true,
          "permiteAgendamento": true
        }
      ],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15640,
      "idSegmento": 498113,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
