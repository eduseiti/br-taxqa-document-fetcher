      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - no caso de beneficiário pessoa física, relativo ao ano-calendário e fornecido, em uma única via, até o último dia útil do mês de fevereiro do ano-calendário subseqüente;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15640,
      "idSegmento": 498106,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - no caso de beneficiário pessoa jurídica, relativo a cada trimestre do ano-calendário e fornecido, em uma única via, até o último dia útil do segundo decêndio subseqüente a cada trimestre do ano-calendário.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15640,
      "idSegmento": 498107,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 7,
      "omitir": true,
      "tachado": false,
      "original": true,
      "compilado": false,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º Para os clientes que possuam endereço eletrônico ou utilizem Internet Banking ou Office Banking, é permitida a disponibilização dos Informes de Rendimentos Financeiros por meio da Internet ou outros meios eletrônicos.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
