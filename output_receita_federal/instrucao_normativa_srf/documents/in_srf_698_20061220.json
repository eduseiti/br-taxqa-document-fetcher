      "original": false,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º-A No caso de conta conjunta, o Informe de Rendimentos Financeiros deve ser formulado em nome do primeiro titular exceto quando os titulares da conta declararem expressamente em nome de qual deles o Informe deve ser formulado.",
      "ancorasOrigem": [],
      "ancorasDestino": [
