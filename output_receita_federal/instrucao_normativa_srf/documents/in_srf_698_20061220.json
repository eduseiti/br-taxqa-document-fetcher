      "idAssunto": 1,
      "ordemSegmentoAto": 16,
      "omitir": false,
      "tachado": false,
      "original": false,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "IV - aos investidores residentes ou domiciliados no exterior.",
