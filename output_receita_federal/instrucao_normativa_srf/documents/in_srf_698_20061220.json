      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "III - no caso das operações denominadas day trade e das operações realizadas no mercado de renda variável sujeitas à retenção do imposto de renda na fonte à alíquota de 0,005% (art. 10 da Instrução Normativa SRF nº 487, de 30 de dezembro de 2004).",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 15640,
