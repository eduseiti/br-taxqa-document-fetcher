      "omitir": false,
      "tachado": false,
      "original": false,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º É permitida a disponibilização dos Informes de Rendimentos Financeiros por meio da Internet ou de outros meios eletrônicos, ficando dispensado, neste caso, o fornecimento da via impressa, para:",
