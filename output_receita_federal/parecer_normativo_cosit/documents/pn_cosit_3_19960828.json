      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Imposto de Renda Pessoa Física - Tratamento tributário da remuneração paga pelo Banco Mundial aos funcionários brasileiros residentes no Brasil.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
