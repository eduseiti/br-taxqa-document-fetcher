      "idTipoSegmento": 999,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "2. Inicialmente, cabe lembrar que o Código Civil assim determina:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
