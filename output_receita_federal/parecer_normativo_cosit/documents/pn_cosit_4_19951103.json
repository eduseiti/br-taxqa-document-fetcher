      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "\"Art. 717 - O usufruto só se pode transferir, por alienação, ao proprietário da coisa; mas o seu exercício pode ceder-se por título gratuito ou oneroso\".",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 30892,
      "idSegmento": 1213898,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 999,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "\"Art. 724 - O usufrutuário pode usufruir em pessoa, ou mediante arrendamento, o prédio ..................\".",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
