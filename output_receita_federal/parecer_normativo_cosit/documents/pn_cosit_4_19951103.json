      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Dúvidas são levantadas a respeito do tratamento fiscal a ser dispensado nos casos de alienação ou cessão de direitos do usufruto.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
