      "idSegmento": 1213915,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 999,
      "ordemSegmentoAto": 23,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I- o valor atribuído para efeito de pagamento do imposto de transmissão;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 30892,
      "idSegmento": 1213916,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 24,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - o valor de transmissão utilizado, na aquisição, para cálculo do ganho de capital do alienante;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 30892,
