      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5216,
      "idSegmento": 25248,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º O Acordo para Evitar a Dupla Tributação em Matéria de Impostos sobre a Renda e o Capital, celebrado entre a República Federal Alemã e a República Federativa do Brasil, cessará de ter vigência, em virtude de sua denúncia, em 1º de janeiro de 2006.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5216,
      "idSegmento": 25249,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º O tratamento tributário previsto no Acordo de que trata este Ato deixará de aplicar-se aos rendimentos auferidos ou pagos, creditados ou remetidos a partir da data mencionada no art. 1º.",
