  "ementas": [
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27764,
      "versaoSegmento": 1,
      "idTipoSegmento": 1,
      "idAssunto": 999,
      "ordemSegmentoAto": 1,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Dispõe sobre a incidência tributária nas operações referentes à linha de crédito especial de que trata a Lei nº 11.524, de 24 de setembro de 2007, destinada a financiar a liquidação de dívidas de produtores rurais ou de suas cooperativas com fornecedores de insumos.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    }
  ],
  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27765,
      "versaoSegmento": 1,
      "idTipoSegmento": 2,
      "idAssunto": 999,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO DA RECEITA FEDERAL DO BRASIL, no uso da atribuição que lhe confere o inciso III do art. 224 do Regimento Interno da Secretaria da Receita Federal do Brasil, aprovado pela Portaria MF nº 95, de 30 de abril de 2007, e tendo em vista o disposto na Lei nº 11.524, de 24 de setembro de 2007, e o que consta do processo nº 10168.004324/2007-42, declara:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27766,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º Os valores das participações para constituição do fundo de liquidez de que trata o art. 3º da Lei nº 11.524, de 2007, instituído para garantia dos financiamentos contratados na forma do art. 1º da mesma Lei, poderão ser considerados como:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316530,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - despesa dedutível na apuração da base de cálculo do imposto de renda e da contribuição social sobre o lucro líquido, quando pagos por pessoa jurídica produtora rural, por sua cooperativa, ou por fornecedor de insumos agropecuários; e",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316531,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - despesa da atividade rural, quando pagos por pessoa física produtora rural.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27767,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º Os rendimentos produzidos pelo fundo de liquidez referido no art. 1º:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316532,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 7,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - não estarão sujeitos à retenção do imposto de renda nos meses de maio e novembro de cada ano, ou no resgate, quando o cotista for instituição relacionada no inciso I do art. 77 da Lei nº 8.981, de 20 de janeiro de 1995;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316533,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 8,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - integrarão a base de cálculo da Contribuição para o PIS/Pasep e da Cofins de acordo com a legislação aplicável aos demais fundos de investimento.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27768,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 9,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 3º O bônus de adimplência de que trata o inciso III do § 1º do art. 3º da Lei nº 11.524, de 2007, devido ao produtor rural ou sua cooperativa:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316534,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 10,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - será classificado como receita operacional, no caso de pessoa jurídica, ou como receita da atividade rural, no caso de pessoa física; e",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316535,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 999,
      "ordemSegmentoAto": 11,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - integrará a base de cálculo da Contribuição para o PIS/Pasep e da Cofins com as alíquotas reduzidas a zero, no caso de pessoa jurídicas que apuram essas contribuições no regime de incidência não-cumulativa, de conformidade com o Decreto nº 5.442, de 29 de maio de 2005.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27769,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 12,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 4º O valor resultante do rateio do saldo do fundo de liquidez, efetuado na forma do inciso VI do § 1º do art. 3º da Lei nº 11.524, de 2007, constituirá receita tributável dos cotistas do referido fundo e da instituição financeira operadora (agente operador).",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316536,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 13,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 1º O valor recebido, na forma do caput, integrará a base de cálculo da Contribuição para o PIS/Pasep na forma do inciso III do art. 2º da Lei nº 9.715, de 25 de novembro de 1998.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 316537,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 999,
      "ordemSegmentoAto": 14,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "§ 2º Na hipótese deste artigo, o fato gerador ocorre na data do rateio, devendo o contribuinte efetuar o recolhimento dos tributos devidos nos prazos previstos na legislação de regência.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 5677,
      "idSegmento": 27770,
      "versaoSegmento": 1,
      "idTipoSegmento": 1000,
      "idAssunto": 999,
      "ordemSegmentoAto": 15,
