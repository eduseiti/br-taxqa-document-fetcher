      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "MÁRIO HENRIQUE SIMONSEN",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
