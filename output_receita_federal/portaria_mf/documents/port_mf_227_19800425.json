      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "EDUARDO PEREIRA DE CARVALHO",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
