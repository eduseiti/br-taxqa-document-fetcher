      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2o Na hipótese de conversão em pecúnia das referidas cotas, os valores recebidos integram o rendimento tributável do beneficiário.",
