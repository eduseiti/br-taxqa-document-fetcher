      "idTipoSegmento": 3,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1o As cotas relativas a direito de uso de serviços postais e telefônicos, bem assim a passagens aéreas atribuídas aos parlamentares no exercício do mandato, nos limites fixados pelo orgão competente, não se sujeitam à tributação pelo imposto sobre a renda na fonte e na Declaração de Ajuste Anual.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
