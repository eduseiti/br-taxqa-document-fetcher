      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Que fica autorizada a dispensa de apresentação de contestação e de interposição de recursos, bem como a desistência dos já interpostos, desde que inexista outro fundamento relevante:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 91232,
