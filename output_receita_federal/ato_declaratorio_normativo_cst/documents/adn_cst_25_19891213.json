      "textoIntegra": "IMPOSTO SOBRE A RENDA E PROVENTOS Rendimento Bruto - Pessoa Física Microempresas - Pessoa Jurídica",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
