      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "\"Dispõe sobre a não retenção do imposto de renda na fonte sobre rendimentos pagos ou creditados por condomínios a profissionais liberais, trabalhadores autônomos e empreiteiros de obras (pessoas físicas)\".",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
