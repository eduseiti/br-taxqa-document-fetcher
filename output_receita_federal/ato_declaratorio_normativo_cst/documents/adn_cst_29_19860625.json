  "outrosSegmentos": [
    {
      "mapper": null,
      "idAto": 6026,
      "idSegmento": 29221,
      "versaoSegmento": 1,
      "idTipoSegmento": 2,
      "idAssunto": 999,
      "ordemSegmentoAto": 2,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O Coordenador do Sistema de Tributação, Substituto, no uso das atribuições que lhe confere o item II da Instrução Normativa do SRF nº 34, de 18 de setembro de 1974, e tendo em vista o disposto no artigo 528 do Regulamento do Imposto de Renda, aprovado pelo Decreto nº 85.450, de 04 de dezembro de 1980,",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 6026,
      "idSegmento": 29222,
      "versaoSegmento": 1,
      "idTipoSegmento": 6,
      "idAssunto": 999,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "DECLARA, em caráter normativo, às unidades descentralizadas da Secretaria da Receita Federal e aos demais interessados, que os rendimentos pagos ou creditados por condomínios a profissionais liberais, trabalhadores autônomos e empreiteiros de obras (pessoas físicas), como remuneração por serviços prestados sem vínculo empregatício com a fonte pagadora, não estão sujeitos à retenção do imposto de renda na fonte.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
