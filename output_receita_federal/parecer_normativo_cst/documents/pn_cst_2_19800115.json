      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Publique-se e, a seguir, encaminhem-se cópias às SS.RR.R.F. para conhecimento e ciência dos demais órgãos subordinados.",
      "ancorasOrigem": [],
