      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 17,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "De acordo",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 142813,
      "idSegmento": 2592820,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 18,
      "omitir": false,
