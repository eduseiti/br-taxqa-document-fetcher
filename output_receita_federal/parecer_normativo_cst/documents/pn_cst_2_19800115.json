      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "Iraci Kahan \n<br>\n FTF",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
