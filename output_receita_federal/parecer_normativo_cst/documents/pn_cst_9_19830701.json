      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "CST, em 30 de junho de 1983.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
