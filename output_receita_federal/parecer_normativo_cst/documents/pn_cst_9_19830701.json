      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "De acordo.&nbsp;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 30911,
