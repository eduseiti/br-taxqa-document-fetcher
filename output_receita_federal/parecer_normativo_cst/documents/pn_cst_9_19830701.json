      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 12,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Publique-se e, a seguir, encaminhem-se cópias às SS.RR.R.F para conhecimento e ciência aos demais órgãos subordinados.",
