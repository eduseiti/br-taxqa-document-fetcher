      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "De acordo.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 30870,
      "idSegmento": 1169967,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 999,
      "ordemSegmentoAto": 16,
