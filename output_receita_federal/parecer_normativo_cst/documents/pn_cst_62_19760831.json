      "ordemSegmentoAto": 15,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": true,
      "textoIntegra": "Juarez de Morais \n<br>\n Fiscal de Tributos Federais",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 121771,
      "idSegmento": 2307364,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 16,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "De acordo.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 121771,
      "idSegmento": 2307365,
      "versaoSegmento": 1,
      "idTipoSegmento": 999,
      "idAssunto": 1,
      "ordemSegmentoAto": 17,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Publique-se e, a seguir, encaminhem-se cópias às SS.RR.R.F. para conhecimento e ciência aos demais órgãos subordinados.&nbsp;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
