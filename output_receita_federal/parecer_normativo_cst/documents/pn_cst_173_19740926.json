  "ementas": [
    {
      "mapper": null,
      "idAto": 115896,
      "idSegmento": 2236440,
      "versaoSegmento": 1,
      "idTipoSegmento": 1,
      "idAssunto": 1,
      "ordemSegmentoAto": 1,
