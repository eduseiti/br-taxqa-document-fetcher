  "epigrafeCompleta": "Parecer Normativo CST nº 28, de 29 de dezembro de 1983",
  "epigrafeSimplificada": "Parecer Normativo CST nº 28, de 29/12/1983",
  "epigrafesAnteriores": [],
  "epigrafeUrl": "Parec. Norm. CST nº 28/1983",
  "dadosPublicacao": "Publicado(a) no DOU de 30/12/1983, seção 1, página 0",
  "dataPublicacao": "1983-12-30",
  "dataVigenciaInicio": "1983-12-30",
