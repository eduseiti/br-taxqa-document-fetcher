      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - as restituições dos contribuintes a que se referem o § 2º do art. 3º da Lei nº 10.741, de 1º de outubro de 2003, o art. 69-A da Lei nº 9.784, de 29 de janeiro de 1999, e o inciso II do parágrafo único do art. 16 da Lei nº 9.250, de 26 de dezembro de 1995;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
