      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 6,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "II - 2º (segundo) lote, em 28 de junho de 2024;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
