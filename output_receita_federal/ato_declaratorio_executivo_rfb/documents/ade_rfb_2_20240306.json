      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "V - 5º (quinto) lote, em 30 de setembro de 2024.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
