      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 2º As restituições serão disponibilizadas para o contribuinte pela ordem de entrega das DIRPF 2024, com observância das seguintes regras de preferência:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
