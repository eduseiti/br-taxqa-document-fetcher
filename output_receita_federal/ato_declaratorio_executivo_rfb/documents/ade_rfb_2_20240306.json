      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "O SECRETÁRIO ESPECIAL DA RECEITA FEDERAL DO BRASIL, no uso da atribuição que lhe confere o inciso III do art. 350 do Regimento Interno da Secretaria Especial da Receita Federal do Brasil, aprovado pela Portaria ME nº 284, de 27 de julho de 2020, e tendo em vista o disposto na Lei nº 9.250, de 26 de dezembro de 1995, na Lei nº 12.527, de 18 de novembro de 2011, e no Decreto nº 7.724, de 16 de maio de 2012, declara:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 136487,
      "idSegmento": 2503296,
      "versaoSegmento": 1,
      "idTipoSegmento": 3,
      "idAssunto": 1,
      "ordemSegmentoAto": 3,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Art. 1º A restituição do Imposto sobre a Renda da Pessoa Física - IRPF, referente ao exercício de 2024, ano-calendário de 2023, será efetuada em 5 (cinco) lotes, no período de maio a setembro de 2024.",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 136487,
      "idSegmento": 2503297,
      "versaoSegmento": 1,
      "idTipoSegmento": 5,
      "idAssunto": 1,
      "ordemSegmentoAto": 4,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "Parágrafo único. O valor a restituir será disponibilizado ao contribuinte na agência bancária por ele indicada na Declaração de Ajuste Anual do Imposto sobre a Renda da Pessoa Física referente a 2024 - DIRPF 2024, de acordo com o seguinte cronograma:",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 136487,
      "idSegmento": 2503298,
      "versaoSegmento": 1,
      "idTipoSegmento": 15,
      "idAssunto": 1,
      "ordemSegmentoAto": 5,
      "omitir": false,
      "tachado": false,
      "original": true,
      "compilado": true,
      "agendado": false,
      "desinenciaTipoSegmento": false,
      "textoIntegra": "I - 1º (primeiro) lote, em 31 de maio de 2024;",
      "ancorasOrigem": [],
      "ancorasDestino": [],
      "arquivoBinario": null,
      "estiloSegmento": null
    },
    {
      "mapper": null,
      "idAto": 136487,
